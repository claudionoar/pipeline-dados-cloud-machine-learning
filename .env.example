# Copie este arquivo para ".env" e preencha com valores reais.
# O .env nunca deve ser commitado (já está no .gitignore).

# ---------------------------------------------------------------------------
# AWS (conta real, free tier)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Só é necessário se suas credenciais forem temporárias (STS/SSO) - deixe vazio se estiver
# usando um usuário IAM "normal" com access key + secret key fixos.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=amazon-pipeline-<seu-sufixo-unico>

# IMPORTANTE: os nomes das variáveis acima são case-sensitive e precisam ficar exatamente
# como estão (MAIÚSCULAS) - o SDK da AWS/Terraform não reconhece aws_access_key_id em
# minúsculas, por exemplo.

# ---------------------------------------------------------------------------
# Kaggle (para baixar os datasets)
# https://www.kaggle.com/settings -> API -> Create New Token
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---------------------------------------------------------------------------
# Snowflake (conta trial: https://signup.snowflake.com/)
# ---------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=AMAZON_PIPELINE_WH
SNOWFLAKE_DATABASE=AMAZON_PIPELINE
# Schema alvo do dbt (staging/dimensions/facts/marts). Os dados brutos carregados via COPY INTO
# ficam sempre no schema RAW (fixo nos scripts SQL em snowflake/sql/), independente deste valor.
SNOWFLAKE_SCHEMA=ANALYTICS
# O stage do Snowflake (snowflake/sql/01_create_stage.sql) usa as credenciais AWS_* acima
# diretamente (CREDENTIALS = AWS_KEY_ID/AWS_SECRET_KEY/AWS_TOKEN), não uma Storage Integration
# com IAM Role - decisão tomada porque contas de laboratório (ex.: AWS Academy Learner Lab)
# tipicamente bloqueiam iam:CreateRole para o aluno. Ver docs/arquitetura.md ("Segurança
# básica") para a limitação documentada. Se sua conta AWS permitir criar IAM Roles, dá para
# voltar para Storage Integration - variáveis abaixo ficam prontas para isso.
SNOWFLAKE_STORAGE_INTEGRATION=S3_AMAZON_PIPELINE_INT
SNOWFLAKE_S3_ROLE_ARN=arn:aws:iam::<account-id>:role/snowflake-amazon-pipeline-role

# ---------------------------------------------------------------------------
# Pipeline
# ---------------------------------------------------------------------------
# true = processa/treina com dados sintéticos em vez dos CSVs reais do Kaggle
# (útil para validar o DAG de ponta a ponta antes do download real, ver data/README.md)
PIPELINE_USE_SAMPLE_DATA=false

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
# Gere com: python -c "import secrets; print(secrets.token_hex(30))"
# Precisa ser igual em webserver/scheduler - sem isso, a UI dá 403 ao tentar abrir logs.
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# Metabase
# ---------------------------------------------------------------------------
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=metabase
METABASE_DB_NAME=metabase
