ia\u00e7\u00e3o qualitativa (docs/avaliacao.md).\n\nwith predictions as (\n    select * from PROJETO_OLIST_DB.ANALYTICS.stg_ml_predictions\n),\n\norders as (\n    select * from PROJETO_OLIST_DB.ANALYTICS.fact_orders\n),\n\ncustomers as (\n    select * from PROJETO_OLIST_DB.ANALYTICS.dim_customers\n)\n\nselect\n    predictions.order_id,\n    predictions.true_label,\n    predictions.predicted_label_hardcode,\n    predictions.predicted_label_sklearn,\n    predictions.model_version,\n    predictions.predicted_at,\n    (predictions.true_label = predictions.predicted_label_hardcode) as hardcode_correct,\n    (predictions.true_label = predictions.predicted_label_sklearn) as sklearn_correct,\n    customers.state as customer_state\nfrom predictions\nleft join orders on predictions.order_id = orders.order_id\nleft join customers on orders.customer_key = customers.customer_key", "relation_name": "PROJETO_OLIST_DB.ANALYTICS.mart_ml_results", "batch_results": null, "overload_results": null}], "elapsed_time": 12.36324954032898, "args": {"maximum_seed_size_mib": 1, "log_format_file": "debug", "cache_selected_only": false, "latest_version_pointer_enabled_by_default": false, "introspect": true, "print": true, "show_resource_report": false, "strict_mode": false, "use_colors_file": true, "require_all_warnings_handled_by_warn_error": true, "allow_jinja_file_extensions": false, "log_format": "default", "require_explicit_package_overrides_for_builtin_materializations": true, "favor_state": false, "use_v2_parser": false, "indirect_selection": "eager", "require_sql_header_in_test_configs": false, "populate_cache": true, "log_path": "/opt/airflow/project/dbt/olist_pipeline/logs", "select": ["stg_ml_predictions", "mart_ml_results"], "project_dir": "/opt/airflow/project/dbt/olist_pipeline", "use_colors": true, "version_check": true, "partial_parse_file_diff": true, "require_source_and_semantic_model_names_without_spaces": false, "require_batched_execution_for_custom_microbatch_strategy": true